---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = "Free Online Image Compressor - 100% Private In-Browser Tool",
  description = "Compress WEBP, JPEG, and PNG images directly in your browser with zero quality loss. 100% free, private, and secure - no files ever leave your device.",
  canonicalUrl = "https://free-image-compressor.github.io/",
  ogImage = "https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786165848/2_ifm3e7.png"
} = Astro.props;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Free Online Image Compressor",
  "operatingSystem": "Any",
  "applicationCategory": "MultimediaApplication",
  "author": {
    "@type": "Person",
    "name": "Kishara",
    "url": "https://ko-fi.com/kishara"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": description,
  "browserRequirements": "Requires JavaScript. Requires HTML5 Canvas support.",
  "softwareRequirements": "Modern Web Browser (Chrome, Firefox, Safari, Edge)",
  "featureList": [
    "100% In-browser private compression",
    "Supports WEBP, JPEG, and PNG image formats",
    "Custom quality percentage slider",
    "Max width resolution options (Original, 1920px, 1280px, 800px)",
    "Instant download with zero watermarks"
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is my data safe when using this image compressor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, 100%! Unlike standard online compression sites that send your photos to remote cloud servers, our tool processes all images locally inside your web browser. No image data is ever transferred over the internet."
      }
    },
    {
      "@type": "Question",
      "name": "Why should I convert images to WEBP format?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "WEBP is a modern image format developed by Google that provides superior lossy and lossless compression for web images. WebP images are typically 25% to 35% smaller than equivalent JPEG or PNG files without sacrificing quality."
      }
    },
    {
      "@type": "Question",
      "name": "How much file size can I reduce?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depending on the original format and target quality setting, file size reductions generally range from 40% up to 90%. Converting large camera JPEGs to 80% WEBP delivers huge file size savings."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a file limit or subscription fee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No! The tool is completely free with no usage limits, no file size caps, no sign-ups, and zero watermarks."
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VTFSFZ02F3" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VTFSFZ02F3');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="image compressor, compress image online, free webp converter, compress jpeg, compress png, client side image compression, privacy image tool" />
    <meta name="author" content="Free Image Compressor" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Free Image Compressor" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Structured Data (SoftwareApplication + FAQPage JSON-LD Schemas) -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body class="bg-slate-50/50 text-slate-900 font-sans antialiased min-h-screen flex flex-col selection:bg-blue-500 selection:text-white">
    <slot />
  </body>
</html>
